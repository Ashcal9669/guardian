      ],
      "description": "Telegram-distributed macOS stealer (2023) targeting Keychain, browser passwords, cryptocurrency wallets, and documents. Delivered as fake apps."
    },
    "XCSSET": {
      "processes": ["XCSSET", "xcssetldr", "agent", "xcassets"],
      "files": [
        "~/Library/Caches/com.apple.safari.extensions",
        "~/Library/LaunchAgents/com.user.update.agent.plist",
        "~/.bash_profile",
        "~/.zshrc"
      ],
      "description": "Sophisticated macOS malware (2020) spreading through infected Xcode projects. Steals browser data, screenshots, takes over browsers, and persists via LaunchAgents. Active M1/M2 variants observed."
    },
    "Silver Sparrow": {
      "processes": ["updater", "taskhook"],
      "files": [
        "~/Library/Application Support/verx",
        "~/Library/Application Support/verxh",
        "~/Library/LaunchAgents/com.updater.mco.plist",
        "~/Library/LaunchAgents/com.tapioka.plist",
        "/tmp/verx"
      ],
      "description": "First M1-native macOS malware (2021). Distributed via malicious ads and fake Adobe Flash updates. Native Apple Silicon binary with a self-destruct mechanism. Final payload was never observed."
    },
    "ThiefQuest/EvilQuest": {
      "processes": ["CrashReporter", "EvilQuest", "ThiefQuest"],
      "files": [
        "~/Library/mixednkey/toolroomd",
        "~/Library/AppQuest/com.apple.questd",
        "~/Library/LaunchAgents/com.apple.questd.plist",
        "~/.syslog"
      ],
      "description": "Ransomware and spyware (2020) distributed via trojanized pirated macOS software torrents. Encrypts files, exfiltrates data including browser cookies and cryptocurrency wallets, and installs a keylogger and reverse shell."
    },
    "OSX.Shlayer": {
      "processes": ["bash", "osascript", "Installer"],
      "files": [
        "/tmp/dmg",
        "/tmp/pkg",
        "~/Library/LaunchAgents/com.adobe.GC.Invoker-1.0.plist",
        "~/Library/LaunchDaemons/com.adobe.GC.Inv.plist",
        "/var/tmp/.lauch"
      ],
      "description": "Most prevalent macOS adware (2019–present). Spread via fake Adobe Flash Player updates and SEO-poisoned search results. Downloads and installs additional adware/malware including Bundlore, Pirrit, and others."
    },
    "Atomic Stealer": {
      "processes": ["AtomicStealer", "Atomic Stealer", "atomicstealer"],
      "files": [
        "/tmp/AtomicStealer",
        "~/Downloads/AtomicStealer.dmg",
        "~/Library/Application Support/AtomicStealer",
        "~/Library/LaunchAgents/com.Atome.plist"
      ],
      "description": "MaaS (Malware-as-a-Service) infostealer (2023) sold on Telegram. Targets browser credentials, cryptocurrency wallets, macOS Keychain, and files. Delivered via malicious ads and fake software downloads."
    },
    "RustBucket": {
      "processes": ["RustBucket", "rustbucket", "pdfview", "pdf viewer"],
      "files": [
        "~/Library/LaunchAgents/com.adobedc.notif.plist",
        "/tmp/pdf_viewer",
        "~/.zsh_history_bak",
        "~/Library/Application Support/.rust"
      ],
      "description": "Lazarus Group (DPRK) macOS backdoor (2023) written in Rust. Delivered as a fake PDF viewer via social engineering targeting crypto/fintech companies. Multi-stage with C2 checks before deploying final payload."
    }
